<?xml version="1.0" encoding="UTF-8"?>
<!--
  Client-side plugin.xml (Mirth 3.x split-layout form).

  Modern Mirth 4.5.2 deployments use the consolidated root-level
  plugin.xml (see ../../plugin.xml) which declares both
  serverClasses and clientClasses in a single file. This split
  file is retained only for backwards compatibility with older
  Mirth 3.x deployments that expect client-plugin.xml.

  FORMAT NOTE: uses the Mirth 4.5.2 format (List of String class
  names + top-level library elements) so that it parses cleanly
  under XStream 1.4.x. See ../../plugin.xml for the full format
  documentation.
-->
<pluginMetaData path="bitdreamit-astm-e1381-transmission">

    <name>ASTM E1381 Transmission Mode (bitdreamit)</name>
    <author>Bit Dream IT</author>
    <pluginVersion>1.2.4</pluginVersion>
    <mirthVersion>4.5.2</mirthVersion>
    <url>https://bitdreamit.com</url>
    <description>ASTM E1381-02 lower-layer transmission framing protocol, client side.
Provides the settings panel (Frame Settings, Validation Settings, Connection
Settings, Mode) used by channel authors when configuring an ASTM E1381
destination connector. Also provides the client-side
TransmissionModeClientProvider that exposes the sample messages and
property-validation hooks for the Mirth channel editor.</description>

    <!--
      The Properties subclass MUST be listed in clientClasses so that
      Mirth's ExtensionController registers it with the CLIENT-side
      XStream security framework. The Administrator UI deserializes
      channel XML locally when editing/viewing channels; without this
      registration, the client throws ForbiddenClassException when
      loading a channel that uses the ASTM E1381 transmission mode.
      See CHANGELOG.md v1.2.0.
    -->
    <clientClasses>
        <string>com.bitdreamit.connect.plugins.transmission.astm.client.ASTME1381TransmissionModeClientPlugin</string>
        <string>com.bitdreamit.connect.plugins.transmission.astm.client.ASTME1381ClientProvider</string>
        <string>com.bitdreamit.connect.plugins.transmission.astm.shared.ASTME1381TransmissionModeProperties</string>
    </clientClasses>

    <library type="CLIENT" path="bitdreamit-astm-e1381-transmission-client.jar" />
    <library type="SHARED" path="bitdreamit-astm-e1381-transmission-shared.jar" />
</pluginMetaData>
