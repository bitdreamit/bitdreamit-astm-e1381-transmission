<?xml version="1.0" encoding="UTF-8"?>
<pluginMetaData path="bitdreamit-astm-e1381-transmission"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="plugin.xsd">
    <name>ASTM E1381 Transmission Mode (bitdreamit)</name>
    <author>Bit Dream IT</author>
    <pluginVersion>1.1.5</pluginVersion>
    <mirthVersion>4.x</mirthVersion>
    <url>https://bitdreamit.com</url>
    <description>ASTM E1381-02 lower-layer transmission framing protocol.
Implements ENQ/ACK/NAK establishment, STX/ETB/ETX framing with Add-Mod-256
checksum, 0-7 frame sequencing with strict/lenient modes, per-frame retry
with exponential backoff, per-phase timeouts (establishment, frame, response),
and a per-session RetryMetrics counter for operational dashboards.
Transport-agnostic: works with TCP Listener / TCP Sender and Serial Connector.</description>
    <!--
        Server-side registration.
        Only the TransmissionModePlugin subclass is registered here - it is
        the entry point that Mirth's connector framework instantiates to
        obtain a StreamHandler. The StreamHandler itself
        (ASTME1381StreamHandler) is loaded transitively.

        Note (Mirth Connect 4.5+): the server-side base class is
        com.mirth.connect.plugins.TransmissionModeProvider (NOT
        TransmissionModeServerProvider, which does not exist). See
        ASTME1381TransmissionModePlugin.java for the API note.

        v1.1.3: removed the registration of ASTME1381ServerProvider,
        which extended a non-existent base class and provided a
        receive() method that does not fit the Mirth StreamHandler
        architecture. The receive flow lives entirely in
        ASTME1381StreamHandler.read().
    -->
    <serverClasses>
        <serverClass class="com.bitdreamit.connect.plugins.transmission.astm.server.ASTME1381TransmissionModePlugin">
            <library path="bitdreamit-astm-e1381-transmission-server.jar" type="SERVER" />
        </serverClass>
    </serverClasses>
</pluginMetaData>
