<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bitdreamit.connect.plugins.transmission.astm</groupId>
    <artifactId>bitdreamit-astm-e1381-transmission</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <name>bitdreamit-astm-e1381-transmission</name>
    <description>ASTM E1381-02 lower-layer transmission mode plugin for Mirth Connect 4.5+</description>
    <url>https://bitdreamit.com</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mirth.libs>${user.home}/mirth-libs</mirth.libs>
        <mirth.version>4.5.2</mirth.version>
        <miglayout.version>4.2</miglayout.version>
        <log4j12api.version>2.17.2</log4j12api.version>
        <junit.version>4.13.2</junit.version>
        <hamcrest.version>1.3</hamcrest.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <!--
        IMPORTANT (build prerequisites)
        ------------------------------------------------------------------
        Mirth Connect jars are not published to Maven Central, so each
        module pulls them in as `system`-scoped dependencies from a local
        folder, by default `${user.home}/mirth-libs/`. Override with
        `-Dmirth.libs=/path/to/mirth-libs` on the command line.

        The shared module's `ASTME1381TransmissionModeProperties` extends
        `com.mirth.connect.model.transmission.TransmissionModeProperties`
        (in mirth-client-core.jar). In Mirth 4.5+ that parent class
        implements `com.mirth.connect.donkey.util.purge.Purgable`, which
        lives in donkey-server.jar. If donkey-server.jar is NOT on the
        classpath, the compiler fails with:

            java: cannot access com.mirth.connect.donkey.util.purge.Purgable
            class file for Purgable not found

        followed by a cascade of "method does not override or implement a
        method from a supertype" and "cannot find symbol" errors. The fix
        is to ensure donkey-server.jar is on the compile classpath of any
        module that depends on the shared module (which is all of them).
        Each module-level pom.xml below already declares it.
    -->

    <modules>
        <module>shared</module>
        <module>server</module>
        <module>client</module>
        <module>test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.bitdreamit.connect.plugins.transmission.astm</groupId>
                <artifactId>bitdreamit-astm-e1381-transmission-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Mirth Connect jars (system-scoped, point at ../mirth-libs/) -->
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client-core</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/mirth-client-core.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/mirth-client.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/mirth-server.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>donkey-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/donkey-server.jar</systemPath>
            </dependency>
            <!--
                MigLayout 4.2 - ships as TWO jars in Mirth Connect 4.5.x:
                  - miglayout-core-4.2.jar    -> net.miginfocom.layout.* (LC, AC, CC, ...)
                  - miglayout-swing-4.2.jar   -> net.miginfocom.swing.MigLayout
                Both jars are required because the swing MigLayout class
                internally references LC at construction time. Without
                miglayout-core on the compile classpath, javac fails with:
                    java: cannot access net.miginfocom.layout.LC
                    class file for net.miginfocom.layout.LC not found
                MigLayout is only used by the client module
                (ASTME1381TransmissionModeSettingsPanel).
            -->
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-core</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/miglayout-core-${miglayout.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-swing</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/miglayout-swing-${miglayout.version}.jar</systemPath>
            </dependency>
            <!--
                log4j-1.2-api-2.17.2.jar - the Log4j 1.x -> 2.x bridge.
                Required by the server module because
                ASTME1381StreamHandler.java imports org.apache.log4j.Logger.
                In Mirth Connect 4.5.2, org.apache.log4j.Logger is a bridge
                class that ships in this JAR (it delegates to Log4j 2.x
                via org.apache.logging.log4j.LogManager). Without this JAR
                on the server compile classpath, javac fails with
                "package org.apache.log4j does not exist".

                Mirth ships log4j-1.2-api-2.17.2.jar at BOTH server/ and
                client/ folders. The server module needs the server/ copy;
                the client module does NOT use Log4j directly (since v1.1.6
                removed the Logger import from ASTME1381ClientProvider).
            -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-1.2-api</artifactId>
                <version>${log4j12api.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/log4j-1.2-api-${log4j12api.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest-core</artifactId>
                <version>${hamcrest.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
